generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TUTOR
  USUARIO
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  name                 String
  passwordHash         String             @map("password_hash")
  role                 Role               @default(USUARIO)
  active               Boolean            @default(true)
  privacyAcceptedAt    DateTime?          @map("privacy_accepted_at")
  consentVersion       String?            @map("consent_version")
  timezone             String             @default("Europe/Madrid")
  pairingCode          String?            @unique @map("pairing_code")
  pairingCodeExpiresAt DateTime?          @map("pairing_code_expires_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  pushSubscriptions    PushSubscription[]
  fcmTokens            FcmToken[]
  tutorLinks           Link[]             @relation("TutorLinks")
  usuarioLinks         Link[]             @relation("UsuarioLinks")
  tutorRoutes          Route[]            @relation("TutorRoutes")
  usuarioRoutes        Route[]            @relation("UsuarioRoutes")

  @@map("users")
}

model Link {
  id        String   @id @default(uuid())
  tutorId   String   @map("tutor_id")
  usuarioId String   @map("usuario_id")
  tutor     User     @relation("TutorLinks", fields: [tutorId], references: [id], onDelete: Cascade)
  usuario   User     @relation("UsuarioLinks", fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tutorId, usuarioId])
  @@map("links")
}

enum TravelMode {
  WALK
  CAR
}

model Route {
  id                  String     @id @default(uuid())
  tutorId             String     @map("tutor_id")
  usuarioId           String     @map("usuario_id")
  label               String
  points              Json
  mode                TravelMode @default(WALK)
  corridorWidthMeters Int        @default(75) @map("corridor_width_meters")
  active              Boolean    @default(true)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  tutor               User       @relation("TutorRoutes", fields: [tutorId], references: [id], onDelete: Cascade)
  usuario             User       @relation("UsuarioRoutes", fields: [usuarioId], references: [id], onDelete: Cascade)
  schedules           Schedule[]
  trips               Trip[]

  @@index([tutorId])
  @@index([usuarioId])
  @@map("routes")
}

enum ScheduleKind {
  WEEKLY
  ONCE
}

model Schedule {
  id                      String       @id @default(uuid())
  routeId                 String       @map("route_id")
  route                   Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  kind                    ScheduleKind @default(WEEKLY)
  days                    Int[]
  time                    String
  windowMinutesBefore     Int          @default(15) @map("window_minutes_before")
  windowMinutesAfter      Int          @default(45) @map("window_minutes_after")
  estimatedArrivalMinutes Int?         @map("estimated_arrival_minutes")
  arrivalToleranceMinutes Int          @default(20) @map("arrival_tolerance_minutes")
  active                  Boolean      @default(true)
  createdAt               DateTime     @default(now()) @map("created_at")
  trips                   Trip[]

  @@index([routeId])
  @@map("schedules")
}

enum TripStatus {
  NOT_STARTED
  IN_PROGRESS
  ARRIVED
  DEVIATED
  DELAYED
  CANCELLED
}

enum EventType {
  DEPARTED
  ARRIVED
  DEVIATED
  DELAYED
  SOS
  LOCATE_RESPONSE
}

model Trip {
  id           String      @id @default(uuid())
  routeId      String      @map("route_id")
  scheduleId   String      @map("schedule_id")
  scheduledFor DateTime    @map("scheduled_for")
  status       TripStatus  @default(NOT_STARTED)
  startedAt    DateTime?   @map("started_at")
  endedAt      DateTime?   @map("ended_at")
  route        Route       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  schedule     Schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  events       TripEvent[]

  @@unique([scheduleId, scheduledFor])
  @@map("trips")
}

model TripEvent {
  id        String    @id @default(uuid())
  tripId    String    @map("trip_id")
  type      EventType
  lat       Float?
  lng       Float?
  createdAt DateTime  @default(now()) @map("created_at")
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_events")
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model FcmToken {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fcm_tokens")
}
