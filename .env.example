# Puerto HTTP interno de la aplicación en Easypanel
PORT=3000

# Copiar aquí la URL de conexión interna completa mostrada por el servicio PostgreSQL
DATABASE_URL=postgresql://postgres:CONTRASENA@bd_rutasegura-postgres:5432/bd?schema=public

# Se crea o promociona automáticamente esta cuenta (rol TUTOR) al arrancar
ADMIN_EMAIL=correo-del-administrador@example.org
ADMIN_NAME=Administrador
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_SEGURA

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# 64 caracteres hexadecimales. No cambiar sin realizar antes una rotación controlada de los datos ya cifrados.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CAMBIAR_POR_64_CARACTERES_HEXADECIMALES

# Generar una sola vez con: npx web-push generate-vapid-keys --json
# La clave pública se envía al navegador; la privada solo debe existir en Easypanel.
VAPID_PUBLIC_KEY=CAMBIAR_POR_LA_CLAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=CAMBIAR_POR_LA_CLAVE_PRIVADA_VAPID
VAPID_SUBJECT=https://rutasegura.placeat.org

# Para "ver ahora" (ubicación puntual bajo demanda vía Firebase Cloud Messaging).
# Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada.
# Pegar aquí el contenido de ese JSON codificado en base64 (para evitar problemas con saltos de línea):
#   node -e "console.log(Buffer.from(require('fs').readFileSync('ruta/al/service-account.json')).toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_BASE64=CAMBIAR_POR_EL_JSON_DE_LA_CUENTA_DE_SERVICIO_EN_BASE64

NODE_ENV=production
